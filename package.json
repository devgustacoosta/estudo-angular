{
  "name": "portal-pedidos",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others -n api,remote,shell \"node api/server.mjs\" \"ng serve pedidos-remote\" \"ng serve shell\"",
    "start:api": "node api/server.mjs",
    "start:shell": "ng serve shell",
    "start:remote": "ng serve pedidos-remote",
    "build": "ng build pedidos-remote && ng build shell",
    "test": "ng test shell --watch=false && ng test pedidos-remote --watch=false && npm run test:api",
    "test:api": "node --test api/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run check:architecture && npm run build && npm test && npm run test:e2e",
    "format": "prettier --write \"projects/**/*.{ts,js,html,css,json}\" \"api/*.mjs\" \"scripts/*.mjs\" \"e2e/*.ts\" \"docs/**/*.md\" playwright.config.ts README.md",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@softarc/native-federation-node": "3.5.6",
    "cors": "2.8.6",
    "es-module-shims": "1.10.1",
    "express": "5.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "21.2.6",
    "@angular-devkit/build-angular": "21.2.26",
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@playwright/test": "1.64.0",
    "concurrently": "10.0.6",
    "jsdom": "28.1.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
